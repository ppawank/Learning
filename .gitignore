# 1. Dependencies
# Never commit the massive node_modules folder
node_modules/
.pnp
.pnp.js

# 2. Production Build Artifacts
# Folders generated by 'npm run build' or 'vite build'
dist/
build/
out/
.next/

# 3. Environment Secrets
# IMPORTANT: Protect your API keys and local secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 4. Debug and Log Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
*.log

# 5. Testing and Coverage
coverage/
.nyc_output

# 6. IDE/Editor Specific Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# 7. OS Generated Files
.DS_Store
Thumbs.db

# 8. TypeScript (if applicable)
*.tsbuildinfo
